<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.chirino.memory-service</groupId>
    <artifactId>memory-service-parent</artifactId>
    <version>999-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>memory-service-process</artifactId>
  <packaging>jar</packaging>
  <name>Memory Service - Managed Process</name>
  <description>Resolve, extract, start, probe, and stop a local Memory Service process</description>

  <!-- This module must stay JDK-only at runtime: no framework, gRPC, or Netty dependencies.
       It is embedded by Quarkus, Spring, and plain Java apps alike; the enforcer rule below
       fails the build if a non-test dependency is added. -->
  <properties>
    <!-- Staged by .github/scripts/binary-oci.sh stage: <platform>/memory-service.oci.properties and
         <platform>/memory-service.sha256 for each released platform. Normal builds have none, and
         the packaged resolver then finds no descriptor. -->
    <memory-service.binaries.dir>${maven.multiModuleProjectDirectory}/../dist/java-binaries</memory-service.binaries.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- OCI descriptors for downloading the native executable
           (docs/enhancements/implemented/119-oci-native-binary-distribution.md). Never the
           executable itself. -->
      <resource>
        <targetPath>META-INF/memory-service</targetPath>
        <filtering>false</filtering>
        <directory>${memory-service.binaries.dir}</directory>
        <includes>
          <include>linux-amd64/memory-service.oci.properties</include>
          <include>linux-amd64/memory-service.sha256</include>
          <include>linux-arm64/memory-service.oci.properties</include>
          <include>linux-arm64/memory-service.sha256</include>
          <include>macos-arm64/memory-service.oci.properties</include>
          <include>macos-arm64/memory-service.sha256</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <!-- The managed-process API is JDK-only at runtime; only test-scope dependencies are allowed. -->
          <execution>
            <id>jdk-only-runtime</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*:*:*:*:compile</exclude>
                    <exclude>*:*:*:*:runtime</exclude>
                    <exclude>*:*:*:*:provided</exclude>
                    <exclude>*:*:*:*:system</exclude>
                  </excludes>
                  <message>memory-service-process must stay JDK-only at runtime: keep framework, gRPC, and Netty dependencies out of this module.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>io.github.chirino.memoryservice.process</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Release builds must package a descriptor for every platform. -->
      <id>binary-descriptors</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.2.0</version>
            <executions>
              <execution>
                <id>validate-native-binary-descriptors</id>
                <goals>
                  <goal>run</goal>
                </goals>
                <phase>initialize</phase>
                <configuration>
                  <target>
                    <available file="${memory-service.binaries.dir}/linux-amd64/memory-service.oci.properties" property="linux-amd64.memory-service.oci.properties.available"/>
                    <fail message="Missing ${memory-service.binaries.dir}/linux-amd64/memory-service.oci.properties" unless="linux-amd64.memory-service.oci.properties.available"/>
                    <available file="${memory-service.binaries.dir}/linux-amd64/memory-service.sha256" property="linux-amd64.memory-service.sha256.available"/>
                    <fail message="Missing ${memory-service.binaries.dir}/linux-amd64/memory-service.sha256" unless="linux-amd64.memory-service.sha256.available"/>
                    <available file="${memory-service.binaries.dir}/linux-arm64/memory-service.oci.properties" property="linux-arm64.memory-service.oci.properties.available"/>
                    <fail message="Missing ${memory-service.binaries.dir}/linux-arm64/memory-service.oci.properties" unless="linux-arm64.memory-service.oci.properties.available"/>
                    <available file="${memory-service.binaries.dir}/linux-arm64/memory-service.sha256" property="linux-arm64.memory-service.sha256.available"/>
                    <fail message="Missing ${memory-service.binaries.dir}/linux-arm64/memory-service.sha256" unless="linux-arm64.memory-service.sha256.available"/>
                    <available file="${memory-service.binaries.dir}/macos-arm64/memory-service.oci.properties" property="macos-arm64.memory-service.oci.properties.available"/>
                    <fail message="Missing ${memory-service.binaries.dir}/macos-arm64/memory-service.oci.properties" unless="macos-arm64.memory-service.oci.properties.available"/>
                    <available file="${memory-service.binaries.dir}/macos-arm64/memory-service.sha256" property="macos-arm64.memory-service.sha256.available"/>
                    <fail message="Missing ${memory-service.binaries.dir}/macos-arm64/memory-service.sha256" unless="macos-arm64.memory-service.sha256.available"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
